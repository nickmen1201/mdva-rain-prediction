# =============================================================================
# MDVA — variables de entorno para deploy productivo
# =============================================================================
# Copiar a .env y completar valores reales. NO subir .env al repo (gitignored).
#
# Uso:
#   cp .env.example .env
#   # editar .env con valores reales
#   docker compose --env-file .env -f docker-compose.prod.yml up -d
#
# Desarrollo (docker-compose.dev.yml y bootRun con perfil dev) solo necesita:
#   GOOGLE_MAPS_API_KEY, POSTGRES_PASSWORD, JWT_SECRET
# El Frontend lee su propia key de Frontend/.env (ver Frontend/.env.example).
# =============================================================================

# ── Spring profile ───────────────────────────────────────────────────────────
# 'prod' activa fail-fast en JWT_SECRET y GOOGLE_MAPS_API_KEY (no defaults).
SPRING_PROFILES_ACTIVE=prod

# ── Base de datos ────────────────────────────────────────────────────────────
# Postgres del docker-compose.prod o externo. Usá un password fuerte.
DATABASE_URL=jdbc:postgresql://postgres:5432/mdva
DATABASE_USERNAME=mdva_app
DATABASE_PASSWORD=cambiame-en-prod

# ── JWT ──────────────────────────────────────────────────────────────────────
# Debe tener al menos 256 bits (32 chars ASCII). Generá con:
#   openssl rand -base64 48
JWT_SECRET=cambiame-por-un-secret-de-al-menos-256-bits-aleatorio

# ── Google Maps API ──────────────────────────────────────────────────────────
# Key restringida por HTTP referrer (frontend) e IP (backend).
GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL exacta del frontend en producción. Acepta varias separadas por coma.
# Sin esta variable Spring permite todos los orígenes (NO usar en prod).
CORS_ALLOWED_ORIGINS=https://mdva.tu-dominio.co

# ── Servicios internos ───────────────────────────────────────────────────────
# Si todos los servicios están en el mismo compose, usar nombres de servicio.
# Si están separados (otro server), poner URLs completas.
ML_SERVICE_URL=http://ml-service:8081
ROUTING_SERVICE_URL=http://routing-service:8000

# ── Postgres (consumido por el container postgres) ───────────────────────────
# DEBE coincidir con DATABASE_USERNAME/PASSWORD/db de arriba.
POSTGRES_DB=mdva
POSTGRES_USER=mdva_app
POSTGRES_PASSWORD=cambiame-en-prod
