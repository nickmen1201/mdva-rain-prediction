# Editor / IDE
.vscode/
.idea/
*.iml

# Claude Code (metadata local, no compartida)
.claude/

# Documentación interna del equipo (Trello/Teams es la fuente)
doc/

# Variables de entorno locales (secretos)
.env

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local Docker overrides (no compartir: evita choques con deploy/prod)
docker-compose.local.yml
docker-compose.*.local.yml
**/Dockerfile.local
**/nginx.local.conf

# Datos (Cookiecutter Data Science v2): nunca se versionan, solo los marcadores de carpeta
/data/**
!/data/**/
!/data/**/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/

# Jupyter
.ipynb_checkpoints/
# Figuras exportadas por notebooks (las figuras finales van a reports/figures/)
/notebooks/**/*.png
